# Go 构建产物（Go 实现位于 aluka_g/）
aluka_g/bin/
aluka_g/dist/
*.exe
*.dll
*.so
*.dylib
aluka_g/aluka
aluka.exe

# Rust 构建产物（另见 aluka_r/.gitignore）
aluka_r/target/

# 测试与覆盖率
*.test
*.out
coverage.txt
coverage.html

# 编辑器/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db

# 项目缓存
.aluka-cache/
node_modules/
aluka_g/demo/vue3-run-build-demo/.generated/
aluka_g/demo/vue3-run-build-demo/dist/

# web bundle Vue demo：真实 vue@3.5.13 离线 fixture 需随仓库分发
!aluka_g/demo/web-bundle-vue-demo/node_modules/
!aluka_g/demo/web-bundle-vue-demo/node_modules/**

# ZCode plan/agent workspace
.zcode/
aluka_g/demo/express-demo/probe.js
# node22 compat：只忽略可再生成的探针结果；manifest/probe/diff/tools 与冻结快照需入库
aluka_g/tests/compat/node22/results/

# node:test 包生态 fixture（condpkg）需入库，测试依赖
!aluka_g/tests/compat/node22/diff/m7-fixtures/pkgapp/node_modules/
!aluka_g/tests/compat/node22/diff/m7-fixtures/pkgapp/node_modules/**/package.json
!aluka_g/tests/compat/node22/diff/m7-fixtures/pkgapp/node_modules/**/*.js
!aluka_g/tests/compat/node22/diff/m7-fixtures/pkgapp/node_modules/**/*.mjs
!aluka_g/tests/compat/node22/diff/m7-fixtures/pkgapp/node_modules/condpkg/

# aluka 编译缓存（node:test fixture 内的运行时产物不入库）
.aluka/

# .freebuff
.freebuff/*
aluka_g/demo/web-bundle-demo/dist/*
aluka_g/demo/web-bundle-vue-demo/dist/*
