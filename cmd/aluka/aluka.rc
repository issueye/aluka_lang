1 ICON "../../assets/icon.ico"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Aluka Project"
            VALUE "FileDescription",  "Aluka JavaScript/TypeScript Runtime"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "aluka"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Aluka Authors"
            VALUE "OriginalFilename", "aluka.exe"
            VALUE "ProductName",      "Aluka"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
